# Slatewell demo env (chunk 4b)
#
# Portal JWKS federation. Slatewell verifies Portal-issued JWTs locally
# using the public key set published at PORTAL_JWKS_URL. See
# portal-shell/docs/PORTAL_GATE_CONTRACT.md for the full contract.
PORTAL_JWKS_URL=https://portal.paradigm.codes/.well-known/jwks.json
PORTAL_EXPECTED_ISSUER=https://auth.paradigm.codes
PORTAL_EXPECTED_AUD=slatewell

# Verifier engine (CA5 cutover). Default is the shared @paradigm-codes/auth
# library. Set to `bespoke` to roll back to the pre-CA5 in-repo verifier
# without a code change. This flag (and the bespoke module) are removed one
# release after the shared engine ships clean.
# PORTAL_VERIFIER=bespoke

# Stripe (deposit holds via manual capture). TEST mode only (sk_test_ /
# pk_test_), never a live key. Both are read at RUNTIME: the server passes
# the publishable key to the browser as a prop (D-013), so no build arg is
# needed. The card-entry deposit step only appears when BOTH are set.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is still accepted as a fallback.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional: override the SQLite path. Defaults to ./data/slatewell.db.
# SLATEWELL_DB_PATH=

# Session signing secret (REQUIRED for the admin area AND for online
# booking, D-014/D-016). Signs the demo-admin and Portal-handoff sessions
# and, under a separately derived key, the visitor cookie (HMAC-SHA-256).
# Without a usable value, booking writes answer 503 and booking detail pages
# 404, because no visitor cookie can be signed or verified. Must be at
# least 32 characters, one bare value (no spaces, notes, or file paths): if
# it is missing, too short, or malformed, the whole admin area
# (/admin, /api/admin, sign-in, Portal handoff) answers 404. This applies in
# local dev too; put a real value in .env.local.
#
# The placeholder below is deliberately SHORTER than 32 characters: it fails
# sessionSecretProblem()'s length rule outright (src/lib/admin-session.ts), so
# a deploy that ships this file verbatim fails closed on length alone. The
# previous 46-char placeholder passed the length check and was caught only by
# an exact-string denylist -- change one character of it and it would have
# signed real sessions. This one cannot be "fixed" into a working secret by a
# small edit; only a real random value clears the length floor.
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE-BEFORE-DEPLOY
